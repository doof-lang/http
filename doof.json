{
  "name": "std/http",
  "version": "0.2.0",
  "license": "ISC",
  "build": {
    "stdlib": {
      "prepare": [
        {
          "program": "sh",
          "args": [
            "${packageRoot}/build-curl.sh",
            "${packageRoot}/vendor/curl",
            "${nativeTarget}",
            "${configureHost}",
            "${targetTriple}",
            "${sdkPath}",
            "${jobs}"
          ]
        }
      ]
    },
    "native": {
      "extraCopyPaths": [
        "native_http_client.hpp",
        "doof-http.js"
      ],
      "macos": {
        "sourceFiles": [
          "native_http_client_apple.mm"
        ],
        "frameworks": [
          "Foundation"
        ]
      },
      "iosSimulator": {
        "sourceFiles": [
          "native_http_client_apple.mm"
        ],
        "frameworks": [
          "Foundation"
        ]
      },
      "iosDevice": {
        "sourceFiles": [
          "native_http_client_apple.mm"
        ],
        "frameworks": [
          "Foundation"
        ]
      },
      "linux": {
        "sourceFiles": [
          "native_http_client_curl.cpp"
        ],
        "extraCopyPaths": [
          "vendor/curl/COPYING",
          "vendor/curl/RELEASE-NOTES"
        ],
        "pkgConfigPackages": [
          "openssl"
        ],
        "compilerFlags": [
          "-pthread"
        ],
        "linkerFlags": [
          "-pthread"
        ],
        "includePaths": [
          "vendor/curl/.doof-build/linux/include"
        ],
        "libraryPaths": [
          "vendor/curl/.doof-build/linux/lib"
        ],
        "linkLibraries": [
          "curl"
        ]
      },
      "windows": {
        "sourceFiles": [
          "native_http_client_windows.cpp"
        ],
        "linkLibraries": [
          "winhttp"
        ]
      },
      "wasm": {
        "sourceFiles": [
          "native_http_client_wasm.cpp"
        ]
      }
    }
  },
  "dependencies": {}
}
