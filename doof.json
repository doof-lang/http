{
  "name": "std/http",
  "version": "0.2.0",
  "license": "ISC",
  "build": {
    "native": {
      "extraCopyPaths": [
        "native_http_client.hpp",
        "doof-http.js"
      ],
      "macos": {
        "sourceFiles": [
          "native_http_client_apple.mm"
        ],
        "frameworks": [
          "Foundation"
        ]
      },
      "iosSimulator": {
        "sourceFiles": [
          "native_http_client_apple.mm"
        ],
        "frameworks": [
          "Foundation"
        ]
      },
      "iosDevice": {
        "sourceFiles": [
          "native_http_client_apple.mm"
        ],
        "frameworks": [
          "Foundation"
        ]
      },
      "linux": {
        "vendor": {
          "key": "curl-8.20.0-r1",
          "static": ["libcurl.a"]
        },
        "sourceFiles": [
          "native_http_client_curl.cpp"
        ],
        "pkgConfigPackages": [
          "openssl"
        ],
        "compilerFlags": [
          "-pthread"
        ],
        "linkerFlags": [
          "-pthread"
        ]
      },
      "windows": {
        "sourceFiles": [
          "native_http_client_windows.cpp"
        ],
        "linkLibraries": [
          "winhttp"
        ]
      },
      "wasm": {
        "sourceFiles": [
          "native_http_client_wasm.cpp"
        ]
      }
    }
  },
  "dependencies": {}
}
